<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 데모 시연 환경에서만 true. 운영 환경에서는 반드시 false로 유지한다. -->
        <add key="DemoSecurityBootstrap" value="false" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
